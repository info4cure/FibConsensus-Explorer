# FibConsensus Explorer Docker runtime example
# Copy to ".env" locally and fill values.
# NEVER commit .env or real credentials.

# Optional host-side port
FIBCONSENSUS_HTTP_PORT=3838

# Optional build-time R version
R_VERSION=4.4.3

# PostgreSQL connection
FIBCONSENSUS_DB_HOST=
FIBCONSENSUS_DB_PORT=5432
FIBCONSENSUS_DB_NAME=
FIBCONSENSUS_DB_USER=
FIBCONSENSUS_DB_PASSWORD=
FIBCONSENSUS_DB_SSLMODE=require
FIBCONSENSUS_DB_POOL_MAX=5
